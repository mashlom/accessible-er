// Colours the world texts table (key in column A, one world per column B..H, header in row 1).
// Yellow: the text is the shared neutral one (child/procedures), the world has no text of its own there.
// Red: the cell is empty.
// Run colourWorldTexts from Extensions > Apps Script.
const SHARED = new Set(["Во рту","Мне кладут в рот маленький пластиковый наконечник с проводком.","Я крепко-крепко закрываю рот, как будто там конфета.","Я тихонько жду чуть-чуть, пока прибор закончит.","Я слышу тихое «бип» — и всё, готово.","Под мышкой","Мне кладут под мышку маленький пластиковый наконечник с проводком.","Я прижимаю руку к телу и мягко держу.","Мне надевают на палец маленькую мягкую прищепку.","В ней загорается маленький красный огонёк.","Она только смотрит — ничего не делает.","Через минутку её снимают.","Мне надевают на руку мягкую манжету.","Она надувается и сжимает, как крепкие объятия.","Мы считаем, и она сама отпускает.","Потом манжету снимают — и всё, готово.","Я встречу врача, который хочет мне помочь.","Врач слушает моё тело стетоскопом — немного холодно, но не больно.","Может быть, мне посмотрят горло и уши маленьким фонариком.","В конце врач будет знать, как мне помочь.","Мне мажут крем, от которого кожа становится менее чувствительной.","Мягкая резинка плотно обхватывает руку.","Маленький быстрый укол — а я могу смотреть на что-то другое.","Мне клеят пластырь, и я молодец!","Я иду в туалет, как всегда.","Я писаю немного в маленький стаканчик.","Я отдаю стаканчик медсестре или медбрату.","Всё!","Мы заходим в комнату с большим аппаратом.","Может быть на меня наденут тяжёлую накидку, которая защищает тело, а может быть ещё и воротник.","Я спокойно стою или лежу, как статуя.","Аппарат делает снимок — я ничего не чувствую.","Готово, можно снова двигаться.","Я спокойно лежу на кровати.","Мне мажут на живот немного холодный гель.","Гладкий датчик скользит и рисует картинку на экране — иногда немного надавливают, и это нормально.","Если мешает, можно попросить маленький перерыв.","Мне вытирают гель — и готово.","Я ложусь на удобную кровать.","Кровать медленно заезжает в большое кольцо.","Я слышу шум и лежу спокойно, как статуя.","Кровать выезжает обратно — готово.","Мне мажут крем, который успокаивает кожу.","Короткий укол, а потом вводят мягкую тонкую трубочку.","Иглу вынимают, а мягкая трубочка остаётся, чтобы давать мне жидкость.","Мне приклеивают наклейку, которая держит мягкую трубочку на месте.","Я получаю лекарство, которое помогает моему телу.","Иногда я пью немного сиропа.","Иногда оно идёт через мягкую трубочку.","А потом можно попить воды, чтобы убрать вкус.","Мне надевают на лицо мягкую маску с прохладным воздухом.","Не нужно дышать сильно — я просто дышу как обычно.","Иногда немного щекочет глаза, и можно попросить, чтобы воздух шёл медленнее.","В это время можно смотреть мультик. Через несколько минут маску снимают — готово.","С обезболиванием","Сначала мажут прохладное средство, от которого место засыпает, и закрывают его прозрачной наклейкой.","Немного ждём, пока волшебство подействует и место пореза «уснёт».","Врач держит это место и закрывает его клеем (как клей из садика, только чистый) или маленькими швами — не больно.","В это время можно смотреть что-нибудь в телефоне, разговаривать с мамой и папой или слушать сказку.","Если клей немного нагревается — мне дуют на лицо прохладным воздухом, а сверху накладывают чистую повязку.","Без обезболивания","Обезболивать не нужно — начинают сразу.","Врач держит это место и наносит на него клей (как клей из садика, только чистый) — не больно.","Я выбираю, сидеть или лежать, и будут ли мама или папа рядом со мной.","Мне обматывают руку или ногу мягкими слоями.","Теперь я терпеливо жду немного и не двигаюсь — останавливаться посередине нельзя, чтобы гипс подошёл мне точно.","Гипс медленно твердеет и бережёт кость — и она заживает.","Мне обматывают это место мягким бинтом.","Обматывают бережно, слой за слоем.","В конце закрепляют — уютно и надёжно.","Мы закончили все проверки — я молодец!","Теперь ждём ответов. Можно поиграть, отдохнуть или посмотреть мультик.","Врачи и медсёстры работают, чтобы мне помочь. Про меня не забыли.","Когда будут ответы, врач придёт и расскажет нам."]);

function colourWorldTexts() {
  const sheet = SpreadsheetApp.getActiveSheet();
  const range = sheet.getDataRange();
  const values = range.getValues();
  const colours = values.map((row, r) => row.map((cell, c) => {
    if (r === 0 || c === 0) return null;
    const text = String(cell).trim();
    if (!text) return "#fbe7e7";
    return SHARED.has(text) ? "#fff4d6" : null;
  }));
  range.setBackgrounds(colours);
}
